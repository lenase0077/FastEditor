<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="FastEditor" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/FastEditor" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="-std=c++14" />
					<Add option="-Wall" />
					<Add directory="imgui" />
				</Compiler>
				<Linker>
					<Add option="-mwindows" />
					<Add library="opengl32" />
					<Add library="gdi32" />
					<Add library="dwmapi" />
					<Add library="comdlg32" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/FastEditor" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-std=c++14" />
					<Add option="-Wall" />
					<Add directory="imgui" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add option="-mwindows" />
					<Add library="opengl32" />
					<Add library="gdi32" />
					<Add library="dwmapi" />
					<Add library="comdlg32" />
				</Linker>
			</Target>
		</Build>
		<Unit filename="main.cpp" />
		<Unit filename="imgui/imgui.cpp" />
		<Unit filename="imgui/imgui_demo.cpp" />
		<Unit filename="imgui/imgui_draw.cpp" />
		<Unit filename="imgui/imgui_tables.cpp" />
		<Unit filename="imgui/imgui_widgets.cpp" />
		<Unit filename="imgui/imgui_impl_win32.cpp" />
		<Unit filename="imgui/imgui_impl_opengl3.cpp" />
		<Extensions />
	</Project>
</CodeBlocks_project_file>
